{
  // 원본과 맞대 보기만 한다 (src/legacy/contract.ts). 아무것도 굽지 않는다.
  // 경로 별칭은 기본 배치(aio/desktop 옆의 aio/node — 롯데·반다이남코, ../naver/ts)를 가리킨다.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@lotte/*": ["../node/src/lotte-test/*"],
      "@bnkr/*": ["../node/src/bnkr-test/*"],
      "@supreme/*": ["../node/src/supreme/*"],
      "@naver/*": ["../../naver/ts/src/*"]
    }
  },
  "files": ["src/legacy/contract.ts"]
}
